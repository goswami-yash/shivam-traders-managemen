CREATE FUNCTION public.user_create_order(in_vehicle_id integer, in_driver_id integer, in_total_loaded_weight numeric, in_loading_bilty_url character varying, in_start_odometer integer DEFAULT 0, in_end_odometer integer DEFAULT 0, in_advance_bhada numeric DEFAULT 0, in_other_kharch numeric DEFAULT 0, in_vehicle_rate_per_ton numeric DEFAULT 0, in_trip_allowance numeric DEFAULT 0, in_transporter_id integer DEFAULT 0, in_transporter_name character varying DEFAULT NULL::character varying, in_labour jsonb DEFAULT NULL::jsonb, in_delivery jsonb DEFAULT NULL::jsonb) RETURNS character varying
    LANGUAGE plpgsql
    AS $$
DECLARE
    in_order_number character varying;
    l JSONB;
    d JSONB;
    cnt INT;
    
BEGIN

    --------------------------------------------------
    -- 🔴 CREATE ORDER
    --------------------------------------------------
    -- IF in_vehicle_id IS NULL OR in_driver_id IS NULL OR 
    --    in_total_loaded_weight IS NULL OR in_loading_bilty_url IS NULL THEN
    --     RAISE EXCEPTION 'Required fields missing'
    --     USING ERRCODE = '22222';
    -- END IF;
IF in_vehicle_id IS NULL THEN
    RAISE EXCEPTION 'vehicle_id is required'
    USING ERRCODE = '22222';
END IF;

IF in_driver_id IS NULL THEN
    RAISE EXCEPTION 'driver_id is required'
    USING ERRCODE = '22222';
END IF;

IF in_total_loaded_weight IS NULL THEN
    RAISE EXCEPTION 'total_loaded_weight is required'
    USING ERRCODE = '22222';
END IF;

IF in_loading_bilty_url IS NULL THEN
    RAISE EXCEPTION 'loading_bilty_url is required'
    USING ERRCODE = '22222';
END IF;
 
    INSERT INTO orders(
       order_number,
        vehicle_id,
        driver_id,
        total_loaded_weight,
        loading_bilty_url,
        start_odometer,
        end_odometer,
        advance_bhada,
        other_kharch,
        vehicle_rate_per_ton,
        trip_allowance,
        transporter_id,
        transporter_name,
        status
    )
    VALUES (
        in_order_number,
        in_vehicle_id,
        in_driver_id,
        in_total_loaded_weight,
        in_loading_bilty_url,
        in_start_odometer,
        in_end_odometer,
        in_advance_bhada,
        in_other_kharch,
        in_vehicle_rate_per_ton,
        in_trip_allowance,
        in_transporter_id,
        in_transporter_name,
        'PENDING_STAFF'
    )RETURNING order_number INTO in_order_number;

    --------------------------------------------------
    -- 🟡 LABOUR INSERT (JSON)
    --------------------------------------------------
    IF in_labour IS NOT NULL THEN
        cnt := 0;

        FOR l IN SELECT * FROM jsonb_array_elements(in_labour)
        LOOP
            cnt := cnt + 1;

            IF cnt > 3 THEN
                RAISE EXCEPTION 'Max 3 labour allowed'
                USING ERRCODE = '22222';
            END IF;

            INSERT INTO order_labourers(
                order_id,
                assin_plot_id,
                item_type,
                weight,
                plot_id,
                labourer_id,
				ord_seq_no
                
            )
            VALUES (
                in_order_number,
                (l->>'assignment_id')::INT,
                (l->>'item_type'),
                (l->>'weight')::NUMERIC,
                (l->>'plot_id')::INT,
                (l->>'labourer_id')::INT,
				cnt
            );
        END LOOP;
    END IF;

    --------------------------------------------------
    -- 🟡 DELIVERY INSERT (JSON)
    --------------------------------------------------
    IF in_delivery IS NOT NULL THEN
        cnt := 0;

        FOR d IN SELECT * FROM jsonb_array_elements(in_delivery)
        LOOP
            cnt := cnt + 1;

            IF cnt > 5 THEN
                RAISE EXCEPTION 'Max 5 customers allowed'
                USING ERRCODE = '22222';
            END IF;

            INSERT INTO order_deliveries(
                order_id,
                customer_id,
                delivery_address_id,
                dispatch_weight,
                item_type,
                delivery_sequence
                
            )
            VALUES (
                in_order_number,
                (d->>'customer_id')::INT,
                (d->>'customer_address_id')::INT,
                (d->>'weight')::NUMERIC,
                (d->>'item_type'),
                cnt
            );
        END LOOP;
    END IF;

    RETURN in_order_number;

END;
$$;


