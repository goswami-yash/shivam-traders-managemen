CREATE FUNCTION public.generate_order_number() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
DECLARE
    curr_date_prefix TEXT;
    next_val BIGINT;
BEGIN
    -- Prefix: ORD + YYMM (India timezone)
    curr_date_prefix := 'ORD' || TO_CHAR(CURRENT_TIMESTAMP AT TIME ZONE 'Asia/Kolkata', 'YYMM');

    -- Get next sequence value (SAFE)
    next_val := nextval('order_number_seq');

    -- Format: ORD + YYMM + 0001
    NEW.order_number := curr_date_prefix || LPAD(next_val::TEXT, 4, '0');

    RETURN NEW;
END;
$$;


