-- Name: user_get_order_full_details(character varying); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.user_get_order_full_details(in_order_id character varying) RETURNS jsonb
    LANGUAGE plpgsql
    AS $$
DECLARE
    result JSONB;
BEGIN

    SELECT jsonb_build_object(

        -- 🔴 ORDER MAIN
        'order', (
            SELECT row_to_json(o)
            FROM orders o
            WHERE o.order_number = in_order_id
        ),

        -- 🟡 LABOUR LIST
        'labour', (
            SELECT COALESCE(jsonb_agg(l), '[]'::jsonb)
            FROM order_labourers l
            WHERE l.order_id = in_order_id
        ),

        -- 🟡 DELIVERY LIST
        'delivery', (
            SELECT COALESCE(jsonb_agg(d), '[]'::jsonb)
            FROM order_deliveries d
            WHERE d.order_id = in_order_id
        ),

        -- 🟡 DIESEL LIST
        'diesel', (
            SELECT COALESCE(jsonb_agg(dl), '[]'::jsonb)
            FROM order_diesel_log dl
            WHERE dl.order_id = in_order_id
        )

    ) INTO result;

    RETURN result;

END;
$$;


