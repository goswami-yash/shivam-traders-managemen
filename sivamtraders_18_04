CREATE FUNCTION public.user_add_diesel_to_order(in_order_id character varying, in_diesel jsonb) RETURNS void
    LANGUAGE plpgsql
    AS $$
DECLARE 
    d JSONB;
    cnt INT;
    existing_cnt INT;
BEGIN

    -- Existing count
    SELECT COUNT(*) INTO existing_cnt
    FROM order_diesel_log
    WHERE order_id = in_order_id;

    cnt := existing_cnt;

    --------------------------------------------------
    -- LOOP JSON ARRAY
    --------------------------------------------------
    FOR d IN SELECT * FROM jsonb_array_elements(in_diesel)
    LOOP
        cnt := cnt + 1;

        -- MAX 3 CHECK
        IF cnt > 3 THEN
            RAISE EXCEPTION 'Max 3 diesel entries allowed'
            USING ERRCODE = '22222';
        END IF;

        -- IMAGE VALIDATION
        IF (
            d->>'price' IS NOT NULL OR
            d->>'liters' IS NOT NULL OR
            d->>'total_price' IS NOT NULL
        ) AND (d->>'diesel_img_url') IS NULL THEN
            RAISE EXCEPTION 'Diesel image is required'
            USING ERRCODE = '22222';
        END IF;

        INSERT INTO order_diesel_log(
            order_id,
            ord_seq_no,
            price,
            liters,
            total_price,
            location,
            time_at,
            diesel_img_url
        )
        VALUES (
            in_order_id,
            cnt,
            (d->>'price')::NUMERIC,
            (d->>'liters')::NUMERIC,
            (d->>'total_price')::NUMERIC,
            (d->>'location'),
            (d->>'time_at')::TIMESTAMP,
            (d->>'diesel_img_url')
        );

    END LOOP;

END;
$$;


