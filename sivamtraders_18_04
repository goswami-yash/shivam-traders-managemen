CREATE FUNCTION public.update_order_with_details(p_order_id character varying, p_vehicle_id integer, p_transporter_id integer, p_transporter_name character varying, p_total_loaded_weight numeric, p_start_odometer integer, p_end_odometer integer, p_advance_bhada numeric, p_other_kharch numeric, p_vehicle_rate_per_ton numeric, p_trip_allowance numeric, p_labour jsonb, p_delivery jsonb) RETURNS void
    LANGUAGE plpgsql
    AS $$
DECLARE
    l JSONB;
    d JSONB;
    cnt INT;
BEGIN
    -- ✅ 1. Update main order
    UPDATE orders
    SET vehicle_id = p_vehicle_id,
        transporter_id = p_transporter_id,
        transporter_name = p_transporter_name,
        total_loaded_weight = p_total_loaded_weight,
        start_odometer = p_start_odometer,
        end_odometer = p_end_odometer,
        advance_bhada = p_advance_bhada,
        other_kharch = p_other_kharch,
        vehicle_rate_per_ton = p_vehicle_rate_per_ton,
        trip_allowance = p_trip_allowance
    WHERE order_number = p_order_id;

    --------------------------------------------------
    -- 🟢 LABOUR
    --------------------------------------------------
    DELETE FROM order_labourers WHERE order_id = p_order_id;

    IF p_labour IS NOT NULL THEN
        cnt := 0;

        FOR l IN SELECT * FROM jsonb_array_elements(p_labour)
        LOOP
            cnt := cnt + 1;

            IF cnt > 3 THEN
                RAISE EXCEPTION 'Max 3 labour allowed';
            END IF;

            INSERT INTO order_labourers(
                order_id,
                assin_plot_id,
                item_type,
                weight,
                plot_id,
                labourer_id,
                ord_seq_no
            )
            VALUES (
                p_order_id,
                (l->>'assignment_id')::INT,
                (l->>'item_type')::INT,
                (l->>'weight')::NUMERIC,
                (l->>'plot_id')::INT,
                (l->>'labourer_id')::INT,
                cnt
            );
        END LOOP;
    END IF;

    --------------------------------------------------
    -- 🟡 DELIVERY
    --------------------------------------------------
    DELETE FROM order_deliveries WHERE order_id = p_order_id;

    IF p_delivery IS NOT NULL THEN
        cnt := 0;

        FOR d IN SELECT * FROM jsonb_array_elements(p_delivery)
        LOOP
            cnt := cnt + 1;

            IF cnt > 5 THEN
                RAISE EXCEPTION 'Max 5 customers allowed';
            END IF;

            INSERT INTO order_deliveries(
                order_id,
                customer_id,
                delivery_address_id,
                dispatch_weight,
                item_type,
                delivery_sequence
            )
            VALUES (
                p_order_id,
                (d->>'customer_id')::INT,
                (d->>'customer_address_id')::INT,
                (d->>'weight')::NUMERIC,
                (d->>'item_type')::INT,
                cnt
            );
        END LOOP;
    END IF;

END;
$$;


