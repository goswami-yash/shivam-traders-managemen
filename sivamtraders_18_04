CREATE FUNCTION public.user_add_diesel_to_order_time(in_order_id character varying, in_diesel jsonb) RETURNS void
    LANGUAGE plpgsql
    AS $$
DECLARE 
    d JSONB;
    existing_ids INT[];
    seq INT := 0;
BEGIN

    --------------------------------------------------
    -- STORE INCOMING IDS
    --------------------------------------------------
    SELECT array_agg((x->>'id')::int)
    INTO existing_ids
    FROM jsonb_array_elements(in_diesel) x
    WHERE x->>'id' IS NOT NULL;

    --------------------------------------------------
    -- DELETE REMOVED ROWS FIRST
    --------------------------------------------------
    DELETE FROM order_diesel_log
    WHERE order_id = in_order_id
    AND (existing_ids IS NULL OR id <> ALL(existing_ids));

    --------------------------------------------------
    -- LOOP JSON (REBUILD SEQUENCE)
    --------------------------------------------------
    FOR d IN SELECT * FROM jsonb_array_elements(in_diesel)
    LOOP
        seq := seq + 1;

        -- LIMIT CHECK (BEFORE INSERT)
        IF seq > 3 THEN
            RAISE EXCEPTION 'Max 3 diesel entries allowed';
        END IF;

        -- IMAGE VALIDATION
        IF (
            d->>'price' IS NOT NULL OR
            d->>'liters' IS NOT NULL OR
            d->>'total_price' IS NOT NULL
        ) AND (d->>'diesel_img_url') IS NULL THEN
            RAISE EXCEPTION 'Diesel image is required';
        END IF;

        --------------------------------------------------
        -- UPDATE
        --------------------------------------------------
        IF (d->>'id') IS NOT NULL THEN

            UPDATE order_diesel_log
            SET
                ord_seq_no = seq,  -- ✅ controlled here
                price = (d->>'price')::NUMERIC,
                liters = (d->>'liters')::NUMERIC,
                total_price = (d->>'total_price')::NUMERIC,
                diesel_img_url = d->>'diesel_img_url',
                location = d->>'location',
                time_at = (d->>'time_at')::TIMESTAMP
            WHERE id = (d->>'id')::INT;

        --------------------------------------------------
        -- INSERT
        --------------------------------------------------
        ELSE

            INSERT INTO order_diesel_log(
                order_id,
                ord_seq_no,
                price,
                liters,
                total_price,
                location,
                time_at,
                diesel_img_url
            )
            VALUES (
                in_order_id,
                seq,  -- ✅ controlled sequence
                (d->>'price')::NUMERIC,
                (d->>'liters')::NUMERIC,
                (d->>'total_price')::NUMERIC,
                d->>'location',
                (d->>'time_at')::TIMESTAMP,
                d->>'diesel_img_url'
            );

        END IF;

    END LOOP;

END;
$$;


