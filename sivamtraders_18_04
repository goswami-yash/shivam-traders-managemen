--
-- TOC entry 280 (class 1255 OID 22042)
-- Name: user_get_order_time_details(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.user_get_order_time_details() RETURNS jsonb
    LANGUAGE plpgsql
    AS $$
DECLARE
    result jsonb;
BEGIN
    SELECT jsonb_build_object(

        -- 1. Customers
        'customers', (
            SELECT COALESCE(jsonb_agg(jsonb_build_object(
                'customer_id', c.id,
                'company_name', c.company_name,
                'customer_address_id', ca.id,
                'address', ca.address
            )), '[]'::jsonb)
            FROM public.customer c
            JOIN public.customer_address ca ON c.id = ca.customer_id
            WHERE c.is_active = true AND ca.is_active = true
        ),

        -- 2. Items
        'items', (
            SELECT COALESCE(jsonb_agg(jsonb_build_object(
                'id', id,
                'name_eng', name_eng,
                'name_guj', name_guj,
                'price', price
            )), '[]'::jsonb)
            FROM public.items 
            WHERE is_active = true
        ),

        -- 3. Labourers
        'labourers', (
            SELECT COALESCE(jsonb_agg(jsonb_build_object(
                'labourer_id', l.id,
                'name_eng', l.name_eng,
                'name_guj', l.name_guj,
                'assignment_id', la.id,
				'plot_id', la.plot_id,
				'plot_name_eng' , p.plot_name_eng,
				'plot_name_guj' , p.plot_name_guj
            )), '[]'::jsonb)
            FROM public.labourer l
            JOIN public.labourer_assignment la ON l.id = la.labourer_id
			JOIN public.plot p ON p.id = la.plot_id
            WHERE l.is_active = true AND la.is_active = true
        ),

        -- 4. Vehicles (WITH transporter)
        'vehicles', (
            SELECT COALESCE(jsonb_agg(jsonb_build_object(
                'id', v.id,
                'vehicle_no', v.vehicle_no,
                'transporter_id', v.transporter_id,
                'transporter_name', t.name
            )), '[]'::jsonb)
            FROM public.vehicle v
            LEFT JOIN public.transporter t 
                ON v.transporter_id = t.id
            WHERE v.is_active = true
        )

    ) INTO result;

    RETURN result;
END;
$$;


